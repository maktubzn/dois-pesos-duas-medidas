{
  "name": "dois-pesos-duas-medidas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest src",
    "arduino:virtual": "node tools/arduino-virtual/cli.mjs",
    "arduino:virtual:self-test": "node tools/arduino-virtual/self-test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "visual:preshow": "playwright test -c playwright.visual.config.ts --grep @visual:preshow",
    "visual:admin": "playwright test -c playwright.visual.config.ts --grep @visual:admin",
    "visual:timers": "playwright test -c playwright.visual.config.ts --grep @visual:timers",
    "visual:full-match": "playwright test -c playwright.visual.config.ts --grep @visual:full-match",
    "visual:tribunal": "playwright test -c playwright.visual.config.ts --grep @visual:tribunal",
    "visual:final-show": "playwright test -c playwright.visual.config.ts --grep @visual:final-show",
    "visual:all": "playwright test -c playwright.visual.config.ts",
    "automacao:operador": "playwright test -c automacao/playwright.config.ts",
    "assets:optimize:h34": "node tools/harness-3.4/optimize-media.mjs",
    "audio:optimize": "node tools/audio/optimize-audio.mjs"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "serialport": "^13.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/howler": "^2.2.12",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
